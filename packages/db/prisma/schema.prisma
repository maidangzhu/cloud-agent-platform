generator client {
  provider = "prisma-client-js"
  // 根本修复（Step 3.1 踩坑）：默认不指定 output 时，Prisma 会把生成产物
  // 写进共享的 node_modules/.pnpm/@prisma+client@<版本>/... 目录。根目录
  // prisma/schema.prisma（v1 旧 schema，无 User/AuthSession）和这份 schema
  // 版本号相同，pnpm 会让两者指向同一个物理目录，谁后跑 generate 谁的
  // 产物覆盖对方——根目录 `pnpm build`（内含 prisma generate）会静默抹掉
  // 这里新增的 User/AuthSession 委托，导致 apps/api 报 "Model user does
  // not exist"（已实测踩坑）。显式指定独立输出路径彻底隔离两份 schema。
  output   = "../node_modules/.prisma-cap-db/client"
}

datasource db {
  provider = "postgresql"
}

model AgentEvent {
  id        String   @id
  runId     String
  seq       Int
  type      String
  role      String?
  title     String?
  content   String?
  raw       Json?
  createdAt DateTime @default(now())
  Run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, createdAt])
}

model Artifact {
  id        String   @id
  runId     String
  kind      String
  title     String?
  path      String?
  content   String?
  metadata  Json?
  createdAt DateTime @default(now())
  Run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id
  sessionId String
  role      String
  content   String
  runId     String?
  createdAt DateTime @default(now())
  Session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Run {
  id              String       @id
  sessionId       String
  userPrompt      String
  status          RunStatus    @default(created)
  maxSteps        Int          @default(60)
  maxDurationSec  Int          @default(780)
  startedAt       DateTime?
  completedAt     DateTime?
  lastHeartbeatAt DateTime?
  error           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  AgentEvent      AgentEvent[]
  Artifact        Artifact[]
  Session         Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ToolCall        ToolCall[]

  @@index([sessionId, createdAt])
  @@index([status, createdAt])
}

model Session {
  id             String        @id
  inviteCodeHash String?
  title          String
  status         SessionStatus @default(active)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  Message        Message[]
  Run            Run[]
  SandboxInstance SandboxInstance?

  @@index([status, createdAt])
}

model ToolCall {
  id          String         @id
  runId       String
  eventSeq    Int
  name        String
  status      ToolCallStatus @default(pending)
  args        Json
  result      Json?
  error       String?
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  Run         Run            @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([name, status])
  @@index([runId, eventSeq])
}

// 重命名自 v1 的 Workspace（原语义是"单个 sandbox 实例状态"，与 v2 顶层
// 概念 Workspace——用户拥有的研究工作区，见 docs/data-model.md §3.1——
// 完全不同，Step 4.1 拷问出的命名冲突，改名规避，不影响根目录 v1
// schema/代码）。
model SandboxInstance {
  id                String        @id
  sessionId         String        @unique
  provider          String        @default("local")
  status            SandboxStatus @default(pending)
  sandboxName       String?
  sandboxState      Json?
  snapshotId        String?
  snapshotExpiresAt DateTime?
  workingDir        String?
  error             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  Session           Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum RunStatus {
  created
  provisioning_workspace
  running
  completed
  failed
  timeout
  cancel_requested
  cancelled
  interrupted
}

enum SessionStatus {
  active
  archived
}

enum ToolCallStatus {
  pending
  running
  completed
  failed
  timeout
  rejected
}

// 重命名自 v1 的 WorkspaceStatus。枚举值暂不对齐 docs/data-model.md §4
// 定义的完整 SandboxStatus（warm/stopped 等），留给 Group 9（Fake Sandbox
// Runner）真正需要时处理，本次只解决命名冲突，不引入本 Step 范围外的
// 行为变化。
enum SandboxStatus {
  pending
  provisioning
  ready
  warm
  stopped
  archived
  failed
}

// v2 顶层概念：用户拥有的研究工作区（docs/data-model.md §3.1，Step 4.1
// 新增）。ownerUserId 是 Better Auth User.id（纯字段，不建关系约束——
// P0 下访问控制收敛为字符串比较即可，见 docs/backend-domain-model.md
// §2；外键 ON DELETE 行为留给后续需要时再补，不在本 Step 范围内）。
model Workspace {
  id          String          @id
  ownerUserId String
  title       String
  status      WorkspaceStatus @default(active)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  archivedAt  DateTime?

  @@index([ownerUserId, updatedAt])
  @@index([status, updatedAt])
}

enum WorkspaceStatus {
  active
  archived
}

// v2 最小 Thread（docs/data-model.md §3.3）。Step 4.2 提前建这张表——
// 只为真实验证"归档 workspace 拒绝创建 thread"的并发原子拒绝（ADR-0018），
// 不在本 Step 实现完整 CRUD/title 派生（留给 Group 5）。字段先只保留
// 验证所需的最小集合，Group 5 会补齐。
model Thread {
  id          String       @id
  workspaceId String
  title       String
  status      ThreadStatus @default(active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  @@index([workspaceId, updatedAt])
  @@index([status, updatedAt])
}

enum ThreadStatus {
  active
  archived
}

// v2 Thread 消息（docs/data-model.md §3.4，原文档里模型名是"Message"）。
// packages/db 这份 schema 已经有一个 v1 遗留的同名 Message model（上面，
// 未加 @@map，物理表名默认为 "Message"），它和根目录 v1 app 自己的
// Message model 共享同一张真实表——真实查过 Neon，这张表有 301 行生产
// 数据，被 v1 agent 主循环/event store/sessions 路由等 10+ 处活代码读写。
// 为避免重演 Step 4.1 的 Workspace/SandboxInstance 撞名险情（那次是空表，
// 这次是有数据且被活代码依赖的表，风险更高），v2 版本改名为
// ThreadMessage，映射到全新物理表，不碰 v1 现有数据/代码路径。TS 层的
// DTO 命名仍按 docs/api-contract.md 用 MessageDTO——那是纯 API 契约层
// 命名，和这里的 Prisma model 标识符是两件独立的事，不需要一致。
model ThreadMessage {
  id          String      @id
  workspaceId String
  threadId    String
  runId       String?
  role        MessageRole
  content     String
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([threadId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([runId])
}

enum MessageRole {
  user
  assistant
  system
}

// v2 AgentRun（docs/data-model.md §3.5，原文档里模型名是"Run"）。
// packages/db 这份 schema 已经有一个 v1 遗留的同名 Run model（下面），
// 真实查过 Neon，这张表有 183 行生产数据，被 v1 run-agent 主循环/4 个
// /api/runs 路由/5+ 处集成测试依赖——是目前撞名影响面最大的一次。v2
// 版本改名为 AgentRun/AgentRunStatus，映射到全新物理表，不碰 v1 现有
// 数据/代码路径。TS 层 DTO 命名仍按 docs/api-contract.md 用 RunDTO。
//
// Step 6.2 先建最小字段集验证 transitionRun 原子 UPDATE 本身，Step 6.3
// 补齐完整字段。不含 data-model.md §3.5 列出的 creditReserved/
// creditDebited——那两个字段属于 ADR-0015 已废弃的 reserve/debit 强制
// 执行机制，ADR-0015 落地后 Run 侧这两个字段就是死字段，文档本身没同步
// 清理（ADR-0015"连锁影响"只提到 CreditLedger/CreditBalance 改名，漏了
// Run 表这两个字段），这里不引入没有存在意义的列。
model AgentRun {
  id              String         @id
  workspaceId     String
  threadId        String
  userId          String
  prompt          String
  status          AgentRunStatus @default(created)
  maxSteps        Int            @default(60)
  maxDurationSec  Int            @default(780)
  startedAt       DateTime?
  completedAt     DateTime?
  lastHeartbeatAt DateTime?
  phase           String?
  error           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([workspaceId, createdAt])
  @@index([threadId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// 对应 docs/state-machines.md §1，含 ADR-0019 新增的 waiting_for_input；
// provisioning_sandbox 命名对齐 docs（v1 的等价状态叫
// provisioning_workspace，命名不同不是笔误，是 v1/v2 概念本来就不同）。
enum AgentRunStatus {
  created
  provisioning_sandbox
  running
  waiting_for_input
  cancel_requested
  completed
  failed
  timeout
  cancelled
  interrupted
}

// v2 RunEvent（docs/data-model.md §3.6，原文档里模型名是"AgentEvent"）。
// packages/db 已有 v1 遗留的同名 AgentEvent model（上面），真实查过
// Neon 有 5965 行生产数据，通过外键关联 v1 Run 并被 v1 event-store.ts/
// /api/runs 路由读写。同 Message/Run 的处理，v2 换名为 RunEvent，不碰
// v1 现有数据/代码路径。
model RunEvent {
  id          String   @id
  workspaceId String
  threadId    String
  runId       String
  seq         Int
  type        String
  role        String?
  title       String?
  content     String?
  raw         Json?
  createdAt   DateTime @default(now())

  @@unique([runId, seq])
  @@index([runId, seq])
  @@index([workspaceId, createdAt])
  @@index([threadId, createdAt])
  @@index([type, createdAt])
}

// v2 RunToolCall（docs/data-model.md §3.7，原文档里模型名是"ToolCall"）。
// packages/db 已有 v1 遗留的同名 ToolCall model（上面），真实查过 Neon
// 有 1559 行生产数据，同样通过外键关联 v1 Run。同上，v2 换名为
// RunToolCall，枚举换名为 RunToolCallStatus（v1 已占用 ToolCallStatus）。
model RunToolCall {
  id          String            @id
  workspaceId String
  runId       String
  eventSeq    Int
  name        String
  status      RunToolCallStatus @default(pending)
  args        Json
  result      Json?
  error       String?
  startedAt   DateTime          @default(now())
  completedAt DateTime?

  @@index([runId, eventSeq])
  @@index([workspaceId, startedAt])
  @@index([name, status])
}

enum RunToolCallStatus {
  pending
  running
  completed
  failed
  timeout
  rejected
}

// v2 WorkspaceFile（docs/data-model.md §3.8）。当前 schema 没有 v1 同名
// model；这里直接使用文档名。P0 只存 latest metadata/content pointer，
// WorkspaceFileVersion 留到后续真正需要历史版本时再加。
model WorkspaceFile {
  id          String            @id
  workspaceId String
  path        String
  kind        WorkspaceFileKind
  mimeType    String?
  size        Int
  contentHash String
  content     String?
  storageKey  String?
  latestRunId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([workspaceId, path])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, path])
  @@index([latestRunId])
}

enum WorkspaceFileKind {
  text
  binary
  directory
}

// v2 WorkspaceArtifact（docs/data-model.md §3.10，原文档里模型名是
// Artifact）。packages/db 已有 v1 Artifact model（上面，关联 v1 Run），
// 因此 v2 版本按当前分支约定换名，不复用旧表。
model WorkspaceArtifact {
  id              String       @id
  workspaceId     String
  threadId        String?
  runId           String
  title           String
  kind            ArtifactKind
  path            String?
  contentSnapshot String?
  storageKey      String?
  version         Int          @default(1)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([threadId, updatedAt])
  @@index([runId, createdAt])
  @@index([kind, updatedAt])
}

model WorkspaceArtifactVersion {
  id              String   @id
  artifactId      String
  workspaceId     String
  runId           String
  version         Int
  contentSnapshot String?
  storageKey      String?
  createdAt       DateTime @default(now())

  @@unique([artifactId, version])
  @@index([artifactId, version])
  @@index([workspaceId, createdAt])
  @@index([runId, createdAt])
}

enum ArtifactKind {
  text
  code
  sheet
  image
}

model Source {
  id          String     @id
  workspaceId String
  runId       String?
  artifactId  String?
  kind        SourceKind
  uri         String?
  title       String?
  contentHash String?
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([workspaceId, createdAt])
  @@index([runId, createdAt])
  @@index([artifactId, createdAt])
  @@index([kind, createdAt])
}

enum SourceKind {
  url
  file
  command
  search_result
  manual
}

// LLM/Search proxy 用量遥测（docs/data-model.md §3.15，ADR-0015）。
// 这是 append-only 观测记录，不参与额度/余额判断，也不阻止 run 执行。
model LLMUsageRecord {
  id               String   @id
  runId            String
  provider         String
  model            String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  ttfbMs           Int?
  durationMs       Int?
  cost             Float?
  createdAt        DateTime @default(now())

  @@index([runId, createdAt])
  @@index([provider, createdAt])
  @@index([model, createdAt])
}

// v2 WorkspaceSandboxInstance（docs/data-model.md §3.13，原文档里模型名是
// SandboxInstance）。packages/db 已有一个旧语义 SandboxInstance model
//（上面，session 级 sandbox 状态），这里沿用 ThreadMessage/AgentRun/
// RunEvent/RunToolCall 的处理方式，v2 版本换名并映射到全新物理表。
model WorkspaceSandboxInstance {
  id                String        @id
  workspaceId       String
  provider          String        @default("vercel")
  sandboxName       String
  status            SandboxStatus @default(pending)
  currentRunId      String?
  sandboxState      Json?
  snapshotId        String?
  snapshotExpiresAt DateTime?
  workingDir        String?
  lastUsedAt        DateTime?
  error             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([provider, sandboxName])
  @@index([status, updatedAt])
  @@index([currentRunId])
}

model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  authsessions  AuthSession[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("AuthSession")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
