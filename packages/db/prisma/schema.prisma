generator client {
  provider = "prisma-client-js"
  // 根本修复（Step 3.1 踩坑）：默认不指定 output 时，Prisma 会把生成产物
  // 写进共享的 node_modules/.pnpm/@prisma+client@<版本>/... 目录。根目录
  // prisma/schema.prisma（v1 旧 schema，无 User/AuthSession）和这份 schema
  // 版本号相同，pnpm 会让两者指向同一个物理目录，谁后跑 generate 谁的
  // 产物覆盖对方——根目录 `pnpm build`（内含 prisma generate）会静默抹掉
  // 这里新增的 User/AuthSession 委托，导致 apps/api 报 "Model user does
  // not exist"（已实测踩坑）。显式指定独立输出路径彻底隔离两份 schema。
  output   = "../node_modules/.prisma-cap-db/client"
}

datasource db {
  provider = "postgresql"
}

model AgentEvent {
  id        String   @id
  runId     String
  seq       Int
  type      String
  role      String?
  title     String?
  content   String?
  raw       Json?
  createdAt DateTime @default(now())
  Run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, createdAt])
}

model Artifact {
  id        String   @id
  runId     String
  kind      String
  title     String?
  path      String?
  content   String?
  metadata  Json?
  createdAt DateTime @default(now())
  Run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id
  sessionId String
  role      String
  content   String
  runId     String?
  createdAt DateTime @default(now())
  Session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Run {
  id              String       @id
  sessionId       String
  userPrompt      String
  status          RunStatus    @default(created)
  maxSteps        Int          @default(60)
  maxDurationSec  Int          @default(780)
  startedAt       DateTime?
  completedAt     DateTime?
  lastHeartbeatAt DateTime?
  error           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  AgentEvent      AgentEvent[]
  Artifact        Artifact[]
  Session         Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ToolCall        ToolCall[]

  @@index([sessionId, createdAt])
  @@index([status, createdAt])
}

model Session {
  id             String        @id
  inviteCodeHash String?
  title          String
  status         SessionStatus @default(active)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  Message        Message[]
  Run            Run[]
  SandboxInstance SandboxInstance?

  @@index([status, createdAt])
}

model ToolCall {
  id          String         @id
  runId       String
  eventSeq    Int
  name        String
  status      ToolCallStatus @default(pending)
  args        Json
  result      Json?
  error       String?
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  Run         Run            @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([name, status])
  @@index([runId, eventSeq])
}

// 重命名自 v1 的 Workspace（原语义是"单个 sandbox 实例状态"，与 v2 顶层
// 概念 Workspace——用户拥有的研究工作区，见 docs/data-model.md §3.1——
// 完全不同，Step 4.1 拷问出的命名冲突，改名规避，不影响根目录 v1
// schema/代码）。
model SandboxInstance {
  id                String        @id
  sessionId         String        @unique
  provider          String        @default("local")
  status            SandboxStatus @default(pending)
  sandboxName       String?
  sandboxState      Json?
  snapshotId        String?
  snapshotExpiresAt DateTime?
  workingDir        String?
  error             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  Session           Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum RunStatus {
  created
  provisioning_workspace
  running
  completed
  failed
  timeout
  cancel_requested
  cancelled
  interrupted
}

enum SessionStatus {
  active
  archived
}

enum ToolCallStatus {
  pending
  running
  completed
  failed
  timeout
  rejected
}

// 重命名自 v1 的 WorkspaceStatus。枚举值暂不对齐 docs/data-model.md §4
// 定义的完整 SandboxStatus（warm/stopped 等），留给 Group 9（Fake Sandbox
// Runner）真正需要时处理，本次只解决命名冲突，不引入本 Step 范围外的
// 行为变化。
enum SandboxStatus {
  pending
  provisioning
  ready
  archived
  failed
}

// v2 顶层概念：用户拥有的研究工作区（docs/data-model.md §3.1，Step 4.1
// 新增）。ownerUserId 是 Better Auth User.id（纯字段，不建关系约束——
// P0 下访问控制收敛为字符串比较即可，见 docs/backend-domain-model.md
// §2；外键 ON DELETE 行为留给后续需要时再补，不在本 Step 范围内）。
model Workspace {
  id          String          @id
  ownerUserId String
  title       String
  status      WorkspaceStatus @default(active)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  archivedAt  DateTime?

  @@index([ownerUserId, updatedAt])
  @@index([status, updatedAt])
}

enum WorkspaceStatus {
  active
  archived
}

// v2 最小 Thread（docs/data-model.md §3.3）。Step 4.2 提前建这张表——
// 只为真实验证"归档 workspace 拒绝创建 thread"的并发原子拒绝（ADR-0018），
// 不在本 Step 实现完整 CRUD/title 派生（留给 Group 5）。字段先只保留
// 验证所需的最小集合，Group 5 会补齐。
model Thread {
  id          String       @id
  workspaceId String
  title       String
  status      ThreadStatus @default(active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?

  @@index([workspaceId, updatedAt])
  @@index([status, updatedAt])
}

enum ThreadStatus {
  active
  archived
}

model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  authsessions  AuthSession[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("AuthSession")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
