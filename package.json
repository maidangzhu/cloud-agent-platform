{
  "name": "cloud-agent-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @cap/api --filter @cap/web dev",
    "build": "pnpm --filter @cap/db generate && pnpm --filter @cap/db build && pnpm --filter @cap/api typecheck && pnpm --filter @cap/web build",
    "start": "pnpm --filter @cap/web start",
    "typecheck": "pnpm --filter @cap/api typecheck && pnpm --filter @cap/web typecheck",
    "test": "pnpm --filter @cap/db build && pnpm --filter @cap/db test && pnpm --filter @cap/api test",
    "test:watch": "pnpm --filter @cap/api test -- --watch",
    "test:integration": "pnpm --filter @cap/db test:integration && pnpm --filter @cap/api test:integration",
    "test:workflow": "pnpm --dir apps/api test:workflow",
    "test:live": "pnpm --dir apps/api test:live",
    "db:generate": "pnpm --filter @cap/db generate",
    "db:push": "pnpm --filter @cap/db db:push"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.9",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "prisma": "7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "undici": "^8.5.0",
    "vitest": "^4.1.9"
  }
}
