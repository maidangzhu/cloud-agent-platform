# Cloud Agent Platform — 环境变量示例
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，切勿提交真实密钥。

# ── 数据库（Neon Postgres）────────────────────────────────────────────
# Prisma 7 运行时走 driver adapter，CLI（migrate/db push）从此变量读取连接串。
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── Auth（Better Auth）────────────────────────────────────────────────
BETTER_AUTH_SECRET="replace-with-random-secret"
# 本地 apps/api 默认 http://localhost:8787；deployed 环境改为公网 API origin。
BETTER_AUTH_URL="http://localhost:8787"

# ── Redis Streams（token stream relay）────────────────────────────────
REDIS_URL="rediss://default:PASSWORD@HOST:PORT"

# ── LLM（OpenAI-compatible；Control Plane 持 key）─────────────────────
# OPENAI_API_KEY / OPENAI_BASE_URL / LLM_MODEL 是 primary channel。
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://your-relay.example.com/v1"
LLM_MODEL="gpt-4o-mini"
# 可选 fallback model（同一 channel 内 fallback）：
LLM_MODEL_FALLBACK=""
# 可选第二 channel，用于 fallback/retry/live-expensive matrix：
OPENAI_API_KEY2=""
OPENAI_BASE_URL2=""
LLM_MODEL2=""
LLM_MODEL_FALLBACK2=""

# ── Search（Exa）──────────────────────────────────────────────────────
EXA_API_KEY=""

# ── 沙箱隔离（Vercel Sandbox，Firecracker microVM）─────────────────────
# 业务测试与生产都跑在真实 Vercel 沙箱上（无 LocalSandbox）。认证用以下任一：
#   - VERCEL_TOKEN（个人 access token，永不过期，推荐）；teamId/projectId 缺省时
#     从 .env.local 的 OIDC token 自动解析
#   - 或 `vercel link` + `vercel env pull` 写入 .env.local 的 VERCEL_OIDC_TOKEN
# 本机访问 vercel.com 若被网络阻断，需开全局/TUN 代理；部署在 Vercel 上无此问题。
VERCEL_TOKEN=""
# 可选（缺省从 .env.local 的 OIDC token 的 owner_id/project_id 解析）：
# VERCEL_TEAM_ID=""
# VERCEL_PROJECT_ID=""

# ── Deployed API / live tests ─────────────────────────────────────────
# Sandbox runner 回调固定走公网 Control Plane；本地开发也不能回调 localhost。
# 未配置时默认使用 https://api.sandbox.maidang.me，可在 preview 环境显式覆盖。
PUBLIC_AGENT_LOOP_BASE_URL="https://api.sandbox.maidang.me"
# test:live 的公网 API base URL。按顺序读取：
# CAP_API_BASE_URL -> API_BASE_URL -> PUBLIC_API_BASE_URL -> PUBLIC_AGENT_LOOP_BASE_URL
CAP_API_BASE_URL="https://your-api-preview.example.com"
# 公网写入类 live tests 使用预置测试账号登录，不自动注册新账号。
CAP_LIVE_TEST_EMAIL="live-test@example.com"
CAP_LIVE_TEST_PASSWORD="replace-with-live-test-password"
